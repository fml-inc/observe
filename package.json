{
  "name": "@fml-inc/fml",
  "version": "0.0.0-dev",
  "description": "FML agent tools for Claude Code",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "fml": "./bin/fml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fml-inc/observe.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/postinstall.cjs",
    ".claude-plugin/"
  ],
  "scripts": {
    "build": "node scripts/generate-plugin-manifest.js && tsup",
    "dev": "tsup --watch",
    "prepack": "node scripts/generate-plugin-manifest.js",
    "pack:local": "pnpm build && pnpm pack",
    "postinstall": "node scripts/postinstall.cjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fml-inc/panopticon": "^0.2.16",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@sentry/core": "^10.43.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
